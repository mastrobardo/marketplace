{
  "name": "marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marketplace for reformas, mantenimiento and urgencias \u2014 API, web app and shared packages.",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@storybook/addon-vitest>vitest": "5",
        "@storybook/addon-vitest>@vitest/browser-playwright": "5"
      }
    }
  },
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10.13.0"
  },
  "scripts": {
    "prepare": "pnpm --filter @marketplace/config build && pnpm --filter @marketplace/api db:generate",
    "stack:up": "docker compose build --quiet objects && docker compose up --detach --wait db mail objects && docker compose run --rm objects-init",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down --volumes",
    "stack:logs": "docker compose logs --follow",
    "db:generate": "pnpm --filter @marketplace/api db:generate",
    "db:migrate": "pnpm --filter @marketplace/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @marketplace/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @marketplace/api db:migrate:status",
    "db:seed": "pnpm --filter @marketplace/api db:seed",
    "db:reset": "pnpm --filter @marketplace/api db:reset",
    "dev": "pnpm turbo run build --filter='@marketplace/web^...' && pnpm --filter @marketplace/web dev",
    "dev:api": "pnpm --filter @marketplace/api dev",
    "storybook": "pnpm --filter @marketplace/ui storybook",
    "storybook:build": "pnpm --filter @marketplace/ui build:storybook",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "turbo run lint && eslint .",
    "test": "turbo run test && vitest run",
    "gates": "tsx scripts/gates/run.ts --all",
    "memory:check": "tsx scripts/memory/check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@marketplace/config": "workspace:*",
    "@types/node": "^24.7.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
