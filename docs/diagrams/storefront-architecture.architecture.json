  "cards": [
    {
      "dot": "cyan",
      "title": "Design system — ADR-012",
      "items": [
        "React Aria supplies behaviour; tokens supply the only appearance",
        "Every story is an accessibility test — a violation fails the PR",
        "A theme is one file, and a second theme proves the swap is real"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storefront — ADR-011",
      "items": [
        "One declaration renders hero, header bar and filter rail",
        "The query lives in the URL — a page renders from the request alone",
        "Results are noindex; the curated city matrix is what gets indexed"
      ]
    },
    {
      "dot": "amber",
      "title": "Boundaries that matter",
      "items": [
        "M11 ends at the auth wall; M1/M3/M4 arrive into a front end that exists",
        "packages/ui never imports packages/contracts",
        "Fixtures come from the shared test factories, never a second set"
      ]
    }
  ]
