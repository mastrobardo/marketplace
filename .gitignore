coverage/
playwright-report/
test-results/

# local db / storage
docker-data/
minio-data/

# editor / os
.DS_Store
.idea/
*.swp

# agent session memory is committed on purpose — see agents/policies/memory.md

# local tool artifacts
.vitest/
