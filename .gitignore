# dependencies
node_modules/
.pnpm-store/

# build output
dist/
storybook-static/

# W12-T16 — Playwright's run output. The *baselines* under packages/ui/visual/baselines are
# committed on purpose (ADR-012 §6); these are the per-run artefacts around them.
visual-results/
visual-report/
build/
.turbo/
*.tsbuildinfo

# env & secrets — never commit a value
.env
.env.*
!.env.example
*.pem
*.key

# generated prisma client — regenerated by `pnpm install` (root `prepare`)
.prisma/
**/generated/prisma/

# test & coverage
coverage/
playwright-report/
test-results/

# local db / storage
docker-data/
minio-data/

# editor / os
.DS_Store
.idea/
*.swp

# agent session memory is committed on purpose — see agents/policies/memory.md

# local tool artifacts
.vitest/
