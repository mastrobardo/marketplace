# Workspace packages are linked, never fetched from the registry.
link-workspace-packages=true
prefer-workspace-packages=true
# A peer mismatch is a real problem — surface it at install time, not at runtime.
# Kept true. The one exception is declared in package.json's `pnpm.peerDependencyRules`:
# @storybook/addon-vitest 10.6 declares vitest ^3||^4 and has not published a Vitest 5 range yet,
# and W12-T03 runs 38 stories through it under Vitest 5 in a real browser — so the mismatch is
# known-good rather than unexamined. Narrow the rule, never the flag: without it the *API image*
# build fails, because `pnpm --prod deploy` resolves the whole workspace.
strict-peer-dependencies=true
# Keep the store flat enough to be fast, strict enough that phantom deps fail here, not in CI.
resolution-mode=highest
