// The shared seam (AGENTS.md L3). `agent-contracts` owns the domain models and adds them in
// `W1-T05`; `W0-T05` deliberately leaves this file with no business meaning at all, so that the
// first schema decision is made while designing the domain rather than while wiring the tooling.
//
// The one model below is infrastructure owned by `agent-devops` — see docs/specs/S0/W0-T05 §8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Which seeders have already run against this database. Makes `pnpm db:seed` idempotent —
/// re-running it is a no-op rather than a duplicate-key error or, worse, duplicated rows.
///
/// It lives in this file rather than in raw SQL because Prisma compares the database against the
/// schema: a table created by a migration but absent here is reported as drift on every later
/// `migrate dev`, which teaches agents to ignore drift warnings.
model SeedRun {
  /// The seeder's own id, e.g. "categories.base".
  id          String   @id
  description String
  ranAt       DateTime @default(now())

  @@map("_seed_run")
}

// ---------------------------------------------------------------------------------------------
// W1-T05 — the core schema. Spec: docs/specs/S1/W1-T05-core-schema.md §5.
//
// Six tables and four enums: an account, the two profiles it can wear, an address book, and the
// service tree. Every location in the platform lives in `address` and nowhere else (§4.1, Q2), so
// there is one generated geography column and one GIST index in the whole product.
// ---------------------------------------------------------------------------------------------

/// What a person may do. Held as an array: a plumber who hires a painter is both.
/// MANITAS/PRO is deliberately *not* here — that lives only on ProviderProfile.kind (§4.2).
enum UserRole {
  CLIENT
  PROVIDER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// The licensing distinction, in its single home. `manitas` = non-licensed (glossary).
enum ProviderKind {
  MANITAS
  PRO

  @@map("provider_kind")
}

enum Locale {
  ES
  EN

  @@map("locale")
}

/// The account. One row per person who can log in, whatever they use the platform for.
///
/// Mapped to `app_user`, not `user`: `user` is a Postgres keyword, and an unquoted
/// `SELECT ... FROM user` does not fail — it silently resolves to `current_user` and returns a
/// row. A table name that turns a typo into wrong data rather than an error is not worth the
/// tidier spelling.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Plain UNIQUE, plus a CHECK that `email = lower(email)` — W2-T01 §4.2.
  ///
  /// W1-T05 chose a *functional* unique index on `lower(email)` and accepted the documented cost
  /// that `WHERE email = $1` would not use it. better-auth issues exactly that predicate through
  /// its Prisma adapter, so the functional index was dead weight on the one code path an
  /// unauthenticated caller can trigger at will. The CHECK is what makes the plain index
  /// equivalent rather than a downgrade: mixed case cannot be stored, so case cannot fork an
  /// account, and the guarantee lives in the database rather than in a library version.
  email           String     @unique(map: "app_user_email_key")
  /// better-auth's `user.emailVerified`. A boolean, because `fields` renames columns and does not
  /// convert types — `email_verified_at` below is the audit fact and answers *when*.
  emailVerified   Boolean    @default(false) @map("email_verified")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// The *account's* name. Not `ClientProfile.displayName`, which is what a provider sees.
  name            String?
  /// better-auth's `user.image`. Nullable and unused until there are avatars.
  image           String?
  /// E.164. UNIQUE, and Postgres treats NULLs as distinct, so many users may have none.
  phone           String?    @unique(map: "app_user_phone_key")
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  roles           UserRole[] @default([CLIENT])
  status          UserStatus @default(ACTIVE)
  locale          Locale     @default(ES)
  /// Soft delete (§4.5). Nothing in the database excludes these rows — W2-T08 owns that, and
  /// W2-T01's session hook is what stops a soft-deleted user authenticating.
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientProfile   ClientProfile?
  providerProfile ProviderProfile?
  addresses       Address[]
  sessions        Session[]
  accounts        Account[]
  jobs            Job[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "app_user_created_at_id_idx")
  @@index([status], map: "app_user_status_idx")
  @@map("app_user")
}

/// ─── better-auth's three tables (W2-T01 §4.1, ADR-005) ──────────────────────────────────────
///
/// In *our* migrations, not generated by better-auth's CLI: ADR-005 asks that an exit stay "a data
/// problem we can already see". Column names are snake_cased to match the rest of this file;
/// better-auth reaches them through `fields` mappings in `src/auth/auth.ts`.

/// One row per active login. ADR-005 rule 3: sessions are database rows, not access tokens, so
/// that revocation means *now* rather than "when the access token expires".
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The opaque value in the cookie. Never logged — `app.ts` redacts `cookie` for this reason.
  token     String   @unique(map: "session_token_key")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_user_id_idx")
  @@index([expiresAt], map: "session_expires_at_idx")
  @@map("session")
}

/// One row per credential. ADR-005 rule 2: the password hash lives here, not on `app_user`, which
/// is also how Google arrives later as a second row rather than as a migration.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `credential` for email+password; a provider id such as `google` otherwise.
  providerId            String    @map("provider_id")
  /// The id *at the provider*. For `credential` better-auth sets it to our own user id.
  accountId             String    @map("account_id")
  userId                String    @map("user_id") @db.Uuid
  /// Set only for `providerId = 'credential'`. Never logged, never returned.
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "account_provider_id_account_id_key")
  @@index([userId], map: "account_user_id_idx")
  @@map("account")
}

/// Email-verification and password-reset tokens. Single use (§8.3): better-auth deletes the row
/// when it is redeemed, so "used once" is enforced by the row's absence rather than by a flag
/// somebody has to remember to check.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What the token is *for* — an email address, or `reset-password:<user id>`.
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@index([expiresAt], map: "verification_expires_at_idx")
  @@map("verification")
}

/// Who a person is when they are hiring.
model ClientProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique(map: "client_profile_user_id_key") @map("user_id") @db.Uuid
  /// What a provider sees. Not the legal name.
  displayName      String   @map("display_name")
  defaultAddressId String?  @map("default_address_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress Address? @relation("ClientDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)

  @@map("client_profile")
}

/// Who a person is when they are working. The row W3 builds on and W3-T05 searches.
model ProviderProfile {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String       @unique(map: "provider_profile_user_id_key") @map("user_id") @db.Uuid
  kind                ProviderKind
  displayName         String       @map("display_name")
  bio                 String?
  /// Where they work from — **the centre of their service radius, not where they live**. A
  /// provider may legitimately set it to a city square and cover 40 km from there (operator's
  /// rule, 2026-09-17; W3-T02). Required: a row without one is excluded from search (W3-T05 AC6)
  /// and cannot be serialised at all (W3-T07 §2.4), so the state is unserviceable rather than
  /// merely unset. They may still enter their home and nothing can tell, which is why no response
  /// may ever return its line1/line2 and why the published point is coarsened (spec §8).
  baseAddressId       String       @map("base_address_id") @db.Uuid
  /// Metres, because ST_DWithin on geography takes metres. CHECK (> 0 AND <= 200000).
  serviceRadiusMetres Int?         @map("service_radius_metres")
  /// Integer cents (W1-T06). CHECK (>= 0). Null = quote-only.
  hourlyRateCents     Int?         @map("hourly_rate_cents")
  /// Denormalised; S4 owns writing it. Null = no reviews yet, which is not 0.00.
  ratingAvg           Decimal?     @map("rating_avg") @db.Decimal(3, 2)
  ratingCount         Int          @default(0) @map("rating_count")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RESTRICT, not SetNull: with the column NOT NULL, "unlist them" is no longer an outcome the
  /// database can produce, and it was never one anybody wanted (W3-T02 §8.1).
  baseAddress Address            @relation("ProviderBaseAddress", fields: [baseAddressId], references: [id], onDelete: Restrict)
  categories  ProviderCategory[]
  quotes      Quote[]

  @@index([baseAddressId], map: "provider_profile_base_address_idx")
  @@index([ratingAvg(sort: Desc), id(sort: Desc)], map: "provider_profile_rating_id_idx")
  @@index([kind], map: "provider_profile_kind_idx")
  @@map("provider_profile")
}

/// A place — and the only table in the schema with a geography column.
model Address {
  id          String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                                 @map("user_id") @db.Uuid
  /// "Casa", "Oficina". User copy, so no enum.
  label       String?
  line1       String
  line2       String?
  city        String
  province    String
  /// CHECK (postal_code ~ '^[0-9]{5}$') — ES only, per the locked market decision.
  postalCode  String                                 @map("postal_code")
  countryCode String                                 @default("ES") @map("country_code") @db.Char(2)
  /// Geocoded client-side. NOT NULL: an address without coordinates is a bug, not a state.
  latitude    Decimal                                @db.Decimal(9, 6)
  longitude   Decimal                                @db.Decimal(9, 6)
  /// GENERATED ALWAYS AS (...) STORED — maintained by Postgres from latitude/longitude.
  /// Present only so Prisma does not report drift (W0-T05 §8); it cannot be read or written
  /// through the client. Proximity queries use $queryRaw with ST_DWithin.
  location    Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint((longitude)::double precision, (latitude)::double precision), 4326))::geography"))

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientDefaultOf ClientProfile[]   @relation("ClientDefaultAddress")
  providerBaseOf  ProviderProfile[] @relation("ProviderBaseAddress")
  jobsAt          Job[]             @relation("JobAddress")

  @@index([userId], map: "address_user_id_idx")
  @@index([location], map: "address_location_gist", type: Gist)
  @@map("address")
}

/// The service tree. W3-T01 seeds it; a human decides which nodes legally require a licence.
model Category {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// URL-safe, stable, ES: `fontaneria`, `electricidad`.
  slug            String  @unique(map: "category_slug_key")
  nameEs          String  @map("name_es")
  nameEn          String  @map("name_en")
  parentId        String? @map("parent_id") @db.Uuid
  /// The legal flag. NOT inherited from the parent — an explicit true on every node that needs
  /// one, so `SELECT slug FROM category WHERE requires_licence` answers the compliance question
  /// completely rather than depending on a recursive walk a query can get wrong (§5.5).
  requiresLicence Boolean @default(false) @map("requires_licence")
  position        Int     @default(0)
  /// Retire a category without deleting rows that reference it.
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]         @relation("CategoryTree")
  providers ProviderCategory[]
  jobs      JobCategory[]

  @@index([parentId, position], map: "category_parent_id_position_idx")
  @@map("category")
}

/// What a provider will do. Explicit rather than an implicit Prisma m-n, because W3-T05 must
/// join it from raw SQL and a generated `_CategoryToProviderProfile` is not a name to rely on.
model ProviderCategory {
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([providerProfileId, categoryId])
  @@index([categoryId], map: "provider_category_category_idx")
  @@map("provider_category")
}

// ---------------------------------------------------------------------------------------------
// W1-T07 — the transition ledger. Spec: docs/specs/S1/W1-T07-state-machine.md §8.
//
// One row per state change, for all six machines TODO.md §3 names. The table is append-only and
// a trigger in migration 0006 enforces it: a ledger whose rows can be edited is a report.
// ---------------------------------------------------------------------------------------------

/// Who caused a transition. SYSTEM is a scheduled close or a webhook — real transitions with no
/// person behind them, which is why `actorId` is nullable and why the pairing is a CHECK (§8.2).
/// `W4-T01`. Two states, and `W4-T02` owns the rest of the lifecycle.
///
/// Declaring AWARDED/IN_PROGRESS/COMPLETED/CANCELLED now would put four values in this enum that
/// nothing can produce and no route can reach. `ALTER TYPE ... ADD VALUE` is a cheap migration.
/// `AWARDED`, `IN_PROGRESS` and `COMPLETED` are deliberately absent, and each is owned by the
/// ticket that can *produce* it: `W4-T05` (award, once a quote can be accepted), then the booking
/// lifecycle in `W5` — see `docs/specs/S4/W4-T02-job-state-machine.md` §6.1. A value here that no
/// route can write is the empty promise this schema keeps refusing.
enum JobStatus {
  DRAFT
  OPEN
  CANCELLED

  @@map("job_status")
}

/// The same four values as `SearchUrgencySchema`, and deliberately not a parallel vocabulary:
/// `W3-T01` §3.1 settled that *urgencia* is `EmergencyRequest` and this field, never a category.
enum JobUrgency {
  urgente
  hoy
  semana
  flexible

  @@map("job_urgency")
}

/// A request for work. `W4-T01` ships the posting half; quotes are `W4-T03`.
///
/// **Almost every column is nullable, and that is the design** (spec §2.2): the operator's rule is
/// that a user completes a minimal flow even with missing parameters. A DRAFT requires nothing but
/// an owner. The single requirement — at least one category — is enforced at *publish*, by
/// `jobMachine`'s guard in `@marketplace/contracts`, because a schema that demanded it would make a
/// draft impossible.
model Job {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  status      JobStatus   @default(DRAFT)
  title       String?
  description String?
  urgency     JobUrgency?

  /// Integer cents, EUR (`money.ts`). A range because "I don't know" is the honest answer for most
  /// first-time clients, and a single figure is read by a provider as a target.
  budgetMinCents Int? @map("budget_min_cents")
  budgetMaxCents Int? @map("budget_max_cents")

  /// Where the work is. Nullable even when OPEN (spec §2.5): a client with no saved address still
  /// gets to post; the job just will not match a radius query until one exists. `SetNull` because
  /// deleting an address must never delete the job.
  addressId String? @map("address_id") @db.Uuid

  /// When it became OPEN. Null while DRAFT, and the only column that records the transition
  /// outside `audit_record`.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  /// When it was cancelled. Mirrors `published_at` — the timestamp a list screen needs without
  /// joining `audit_record`. The *reason* is not a column: it is `audit_record.metadata`, so that
  /// one fact has one home (`W4-T02` §2.5).
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address    Address?      @relation("JobAddress", fields: [addressId], references: [id], onDelete: SetNull)
  categories JobCategory[]
  quotes     Quote[]

  @@index([clientId, createdAt(sort: Desc), id(sort: Desc)], map: "job_client_created_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "job_status_created_idx")
  @@map("job")
}

/// Many-to-many, because a bathroom is not one trade — the operator's example, 2026-09-20:
/// *"a reformation of a bathroom, might need tiles, plumbing, and electricity"*.
///
/// Mirrors `ProviderCategory` exactly: composite key, Cascade from the owner, Restrict to the
/// category so a trade in use cannot be deleted, and an index on `category_id` for the reverse
/// lookup `W4-T07` needs when it matches a provider to a feed.
model JobCategory {
  jobId      String   @map("job_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([jobId, categoryId])
  @@index([categoryId], map: "job_category_category_idx")
  @@map("job_category")
}

/// `W4-T03`. Two values, because `ACCEPTED`/`REJECTED` belong to `W4-T04` — the ticket that can
/// produce them. `EXPIRED` is deliberately **not** a value: it is what `valid_until` already says,
/// and a status that only becomes true when a sweep runs is wrong between the sweeps.
enum QuoteStatus {
  PENDING
  WITHDRAWN

  @@map("quote_status")
}

/// A *presupuesto*: **one quote for the whole job**, never for part of it (spec §2.1). The operator,
/// 2026-09-20: *"It would be also too chaotic for a user accepting X presupuestos"* — a client who
/// wants a bathroom should not have to become a general contractor to get one.
///
/// There is no link to `job_category`: a quote covers everything the job names. Which of those
/// trades the provider actually lists is computed at read time and shown to the client (§2.3), and
/// **restricts nothing** — *"It is up to the professional to decide to apply or not."*
model Quote {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String      @map("job_id") @db.Uuid
  /// The `provider_profile` that wrote it, not the `app_user` — a quote is written in a
  /// professional capacity, and the profile is what carries the rating and the rate the client
  /// weighs it by.
  providerId String      @map("provider_id") @db.Uuid
  status     QuoteStatus @default(PENDING)

  /// Integer cents, EUR (`money.ts`). **Information, not an instruction** — ADR-013 §4.1: the job's
  /// price never passes through this platform, so nothing charges this and nothing reconciles
  /// against it.
  amountCents Int @map("amount_cents")

  /// Prose, not line items. A professional who wants to itemise can; the schema does not demand it
  /// of everyone who does not (`W4-T01`'s rule about required fields).
  breakdown String?

  /// When the offer lapses. Required: an open-ended price on building work is not an offer.
  validUntil DateTime @map("valid_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// One **active** quote per provider per job — the slice's own non-negotiable, and enforced here
  /// rather than only in the service. Partial (`WHERE status = 'PENDING'`), written by hand in
  /// `0012` because Prisma cannot express a partial index: a plain unique constraint would make a
  /// withdrawn quote a permanent bar on ever quoting that job again.
  @@index([jobId, createdAt(sort: Desc), id(sort: Desc)], map: "quote_job_created_idx")
  @@index([providerId, createdAt(sort: Desc), id(sort: Desc)], map: "quote_provider_created_idx")
  @@map("quote")
}

enum ActorType {
  USER
  SYSTEM

  @@map("actor_type")
}

/// A state change that happened. Written only through `transition()` in `@marketplace/contracts`,
/// which cannot return a new state without having called a recorder (spec §4.4, Decision A).
model AuditRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The machine's name — `booking`, `job`. Text, not an enum: an enum here would list every
  /// state of every slice in the shared schema, making a new booking event a migration (§8.2).
  entity    String
  entityId  String @map("entity_id") @db.Uuid
  /// The event that fired, e.g. `PAYMENT_CAPTURED`.
  action    String
  fromState String @map("from_state")
  toState   String @map("to_state")

  actorType ActorType @map("actor_type")
  /// Deliberately **no** foreign key. W2-T08 (GDPR erasure) may hard-delete the user row: CASCADE
  /// would erase the ledger of what they did and RESTRICT would block the erasure the law
  /// requires. The one place in this schema where a dangling reference is the right design.
  actorId   String?   @map("actor_id") @db.Uuid

  /// Whatever makes the row legible for its machine — a refund amount, a winning bid. Not indexed.
  metadata Json?

  /// No column default, on purpose. The value always comes from the application (spec §8.2), so
  /// there is one source of truth for when a transition happened.
  at DateTime @db.Timestamptz(3)

  @@index([entity, entityId, at(sort: Desc), id(sort: Desc)], map: "audit_record_entity_at_idx")
  @@index([actorId, at(sort: Desc), id(sort: Desc)], map: "audit_record_actor_at_idx")
  @@map("audit_record")
}
