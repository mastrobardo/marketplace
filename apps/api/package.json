{
  "name": "@marketplace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API — health, config, error envelope, request-id and structured logging.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@marketplace/config": "workspace:*",
    "@marketplace/testing": "workspace:*",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.10.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@marketplace/contracts": "workspace:*",
    "@prisma/client": "^6.19.3",
    "better-auth": "1.7.4",
    "fastify": "^5.12.3",
    "nodemailer": "^10.0.9",
    "zod": "^4.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
