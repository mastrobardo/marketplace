{
  "name": "@marketplace/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one place TypeScript, ESLint, Prettier and Vitest are configured. Owned by agent-devops (slice S0).",
  "exports": {
    "./eslint": {
      "import": {
        "types": "./dist/eslint.d.ts",
        "default": "./dist/eslint.js"
      },
      "require": {
        "types": "./dist/eslint.d.cts",
        "default": "./dist/eslint.cjs"
      }
    },
    "./prettier": {
      "import": {
        "types": "./dist/prettier.d.ts",
        "default": "./dist/prettier.js"
      },
      "require": {
        "types": "./dist/prettier.d.cts",
        "default": "./dist/prettier.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json"
  },
  "files": [
    "dist",
    "tsconfig"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3",
    "typescript": ">=5.5 <5.10",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
