{
  "name": "@marketplace/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared test factories — the only source of test data in this repo. Owned by agent-contracts (slice S1).",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@marketplace/config": "workspace:*",
    "@types/node": "^24.7.2",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
