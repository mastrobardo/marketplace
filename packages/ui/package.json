{
  "name": "@marketplace/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system \u2014 tokens, primitives and patterns. The only place a component is defined (ADR-012).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/ui.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:storybook": "storybook build --output-dir storybook-static",
    "storybook": "storybook dev --port 6006 --no-open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@marketplace/config": "workspace:*",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.56.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
